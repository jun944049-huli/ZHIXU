{
  "name": "xiaoyu-workbench",
  "version": "0.2.11",
  "private": true,
  "description": "知序 · 个人工作台",
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "predev": "node scripts/sync-assets.mjs",
    "dev": "electron-vite dev",
    "predev:web": "node scripts/sync-assets.mjs",
    "dev:web": "vite --config vite.web.config.ts",
    "prebuild": "node scripts/sync-assets.mjs && node scripts/prepare-plugin-runtime.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "test": "tsx --test tests/*.test.ts",
    "test:desktop": "node tests/desktop.smoke.mjs",
    "test:web": "node tests/browser.smoke.mjs",
    "test:design": "node tests/design.smoke.mjs",
    "brand:render": "node scripts/render-brand.mjs",
    "test:interfaces": "node tests/interfaces.smoke.mjs",
    "test:documents": "node tests/documents.smoke.mjs",
    "test:analysis": "node tests/document-analysis.smoke.mjs",
    "test:capture": "node tests/capture.smoke.mjs",
    "test:progress-notes": "node tests/progress-notes.smoke.mjs",
    "test:providers": "node tests/providers.smoke.mjs",
    "test:chat": "node tests/chat.smoke.mjs",
    "test:stakeholders": "node tests/stakeholders.smoke.mjs",
    "test:workspace": "node tests/workspace.smoke.mjs",
    "test:plugins": "node tests/plugins.smoke.mjs",
    "test:overdue": "node tests/overdue.smoke.mjs",
    "test:overdue-layout": "node tests/overdue-layout.smoke.mjs",
    "test:startup": "node tests/startup.smoke.mjs",
    "test:remote": "node tests/remote.smoke.mjs",
    "test:updates": "node tests/updates.smoke.mjs",
    "pack": "npm run build && electron-builder --win dir",
    "dist": "npm run build && electron-builder --win nsis",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "docx": "^9.13.0",
    "electron-updater": "6.8.11",
    "exceljs": "^4.4.0",
    "imapflow": "^2.5.9",
    "node-ical": "^0.27.3",
    "officeparser": "^8.1.1",
    "postal-mime": "^4.0.11",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "word-extractor": "^1.0.4",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^6.0.0",
    "ip-address": "10.7.4",
    "npm": "12.2.1",
    "pptxgenjs": "^4.0.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^8.0.0"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  },
  "build": {
    "appId": "cn.xiaoyu.workbench",
    "productName": "知序",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "afterPack": "scripts/copy-plugin-runtime.cjs",
    "publish": {
      "provider": "github",
      "owner": "jun944049-huli",
      "repo": "HULIKU",
      "private": true
    },
    "win": {
      "executableName": "Xiaoyu",
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "artifactName": "Zhixu-${version}-Windows-Setup.exe",
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "知序",
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh"
    }
  }
}
