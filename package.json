{
  "name": "xiaoyu-workbench",
  "version": "0.1.5",
  "private": true,
  "description": "Xiaoyu personal workbench",
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "predev": "node scripts/sync-assets.mjs",
    "dev": "electron-vite dev",
    "predev:web": "node scripts/sync-assets.mjs",
    "dev:web": "vite --config vite.web.config.ts",
    "prebuild": "node scripts/sync-assets.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "test": "tsx --test tests/*.test.ts",
    "test:desktop": "node tests/desktop.smoke.mjs",
    "test:web": "node tests/browser.smoke.mjs",
    "test:interfaces": "node tests/interfaces.smoke.mjs",
    "pack": "npm run build && electron-builder --win dir",
    "dist": "npm run build && electron-builder --win portable",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "docx": "^9.13.0",
    "exceljs": "^4.4.0",
    "imapflow": "^2.5.9",
    "node-ical": "^0.27.3",
    "postal-mime": "^4.0.11",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^6.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^8.0.0"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  },
  "build": {
    "appId": "cn.xiaoyu.workbench",
    "productName": "Xiaoyu",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "Xiaoyu-${version}-Windows.exe"
    }
  }
}
